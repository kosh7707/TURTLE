# A backend is source, never a runtime-loaded module.
function(turtle_implementation NAME)
  cmake_parse_arguments(IMPL "" "" "SOURCES;INCLUDES;LIBRARIES;DEFINITIONS" ${ARGN})
  add_library(turtle_${NAME} STATIC ${IMPL_SOURCES})
  target_include_directories(turtle_${NAME} PRIVATE "${PROJECT_SOURCE_DIR}/include")
  target_include_directories(turtle_${NAME} SYSTEM PRIVATE ${IMPL_INCLUDES})
  target_compile_options(turtle_${NAME} PRIVATE -Wall -Wextra -Wno-deprecated-declarations)
  target_compile_definitions(turtle_${NAME} PRIVATE ${IMPL_DEFINITIONS})
  target_link_libraries(turtle_${NAME} PUBLIC ${IMPL_LIBRARIES})
  foreach(role client server)
    add_executable(turtle-${NAME}-${role} "${PROJECT_SOURCE_DIR}/src/endpoint/main.cpp")
    target_compile_options(turtle-${NAME}-${role} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    target_link_libraries(turtle-${NAME}-${role} PRIVATE turtle_core turtle_${NAME})
    string(TOUPPER ${role} upper)
    target_compile_definitions(turtle-${NAME}-${role} PRIVATE TURTLE_ROLE=TURTLE_${upper})
    set_target_properties(turtle-${NAME}-${role} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
    install(TARGETS turtle-${NAME}-${role} RUNTIME DESTINATION bin)
  endforeach()
endfunction()
