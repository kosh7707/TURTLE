{
  "network": "loopback",
  "warmups": 1,
  "repetitions": 3,
  "configurations": [{
    "id": "direct-mtls",
    "scenario": "S3",
    "auth": "mtls",
    "measured_role": "client",
    "recording": "basic",
    "expected": {"group": "X25519"},
    "application": {"request": "ping", "response": "pong"},
    "required_metrics": ["scenario_wall_ns"],
    "client": {
      "binary": "out/build/native/turtle-openssl",
      "args": ["--ca", "out/certificates/ca.crt", "--peer", "localhost", "--cert", "out/certificates/client.crt", "--key", "out/certificates/client.key", "--groups", "X25519"]
    },
    "server": {
      "binary": "out/build/native/turtle-wolfssl",
      "args": ["--ca", "out/certificates/ca.crt", "--cert", "out/certificates/server.crt", "--key", "out/certificates/server.key", "--groups", "X25519"]
    },
    "inputs": ["out/certificates/ca.crt", "out/certificates/client.crt", "out/certificates/client.key", "out/certificates/server.crt", "out/certificates/server.key"]
  }]
}
