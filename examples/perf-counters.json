{
  "network": "loopback",
  "repetitions": 30,
  "seed": 0,
  "baseline": "openssl-counters",
  "configurations": [
    {
      "id": "openssl-counters",
      "measurement": {"perf_counters": true},
      "inputs": ["out/certificates/server.crt", "out/certificates/server.key"],
      "client": {"binary": "out/build/native/turtle-openssl", "args": ["--ca", "out/certificates/server.crt", "--groups", "X25519MLKEM768"]},
      "server": {"binary": "out/build/native/turtle-openssl", "args": ["--cert", "out/certificates/server.crt", "--key", "out/certificates/server.key", "--groups", "X25519MLKEM768"]}
    },
    {
      "id": "wolfssl-counters",
      "measurement": {"perf_counters": true},
      "inputs": ["out/certificates/server.crt", "out/certificates/server.key"],
      "client": {"binary": "out/build/native/turtle-wolfssl", "args": ["--ca", "out/certificates/server.crt", "--groups", "X25519MLKEM768"]},
      "server": {"binary": "out/build/native/turtle-wolfssl", "args": ["--cert", "out/certificates/server.crt", "--key", "out/certificates/server.key", "--groups", "X25519MLKEM768"]}
    }
  ]
}
