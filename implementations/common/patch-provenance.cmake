function(turtle_check_patch_manifest name expected)
  set(manifest "${TURTLE_DEPS_ROOT}/manifests/${name}-instrumentation.sha256")
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Missing installed patch manifest for ${name}; rebuild with the TURTLE dependency script")
  endif()
  file(READ "${manifest}" content)
  string(SUBSTRING "${content}" 0 64 installed)
  if(NOT installed STREQUAL expected)
    message(FATAL_ERROR "${name} source patch changed; rebuild the dependency before building its adapter")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
endfunction()
