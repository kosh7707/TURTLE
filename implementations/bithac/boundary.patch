+int TurtleCiCreate(WOLFSSL_CTX *ctx)
+{
+    TurtleCiState *state = (TurtleCiState*)XMALLOC(sizeof(*state), ctx->heap, DYNAMIC_TYPE_TLSX);
+    if (state == NULL) return MEMORY_E;
