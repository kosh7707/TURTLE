+size_t TurtleCiBytes(WOLFSSL_CTX *ctx)
+{
+    TurtleCiState *state=(TurtleCiState*)ctx->turtle_ci_state;
+    CICachePeerIndex *peer;
+    int row,entry;
+    size_t bytes=state?sizeof(*state):0;
+    if (!state) return 0;
+    for(row=0;row<CI_CACHE_ROWS;++row) for(entry=0;entry<CI_CACHE_ENTRIES_PER_ROW;++entry)
+        if(state->rows[row].Entries[entry].data.buffer) bytes+=state->rows[row].Entries[entry].data.length;
+    for(peer=state->peers;peer;peer=peer->next) {
+        struct CICachePeerIndexEntry *item;bytes+=sizeof(*peer);
+        for(item=peer->entries;item;item=item->next) bytes+=sizeof(*item);
+    }
+    return bytes;
+}
+void TurtleCiDestroy(WOLFSSL_CTX *ctx)
+{
+    TurtleCiState *state = (TurtleCiState*)ctx->turtle_ci_state;
+    int row, entry;
+    if (state == NULL) return;
+    for (row=0; row<CI_CACHE_ROWS; ++row) for (entry=0; entry<CI_CACHE_ENTRIES_PER_ROW; ++entry)
+        XFREE(state->rows[row].Entries[entry].data.buffer, ctx->heap, DYNAMIC_TYPE_TLSX);
+    while (state->peers != NULL) {
+        CICachePeerIndex *peer=state->peers;
+        state->peers=peer->next;
+        while (peer->entries != NULL) {
+            struct CICachePeerIndexEntry *entry=peer->entries;
+            peer->entries=entry->next; XFREE(entry,ctx->heap,DYNAMIC_TYPE_TLSX);
+        }
+        XFREE(peer,ctx->heap,DYNAMIC_TYPE_TLSX);
+    }
+    wc_FreeRwLock(&state->cache_lock);wc_FreeRwLock(&state->peer_lock);
+    XFREE(state,ctx->heap,DYNAMIC_TYPE_TLSX);ctx->turtle_ci_state=NULL;
