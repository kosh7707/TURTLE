+/* TURTLE source boundaries. These entry points never drive a handshake loop. */
+int TurtleWolfCapture(WOLFSSL* ssl, const byte* bytes, int length)
+{
+    if (length < 0 || (word32)length > ssl->turtle_capacity - ssl->turtle_length)
+        return BUFFER_E;
+    XMEMCPY(ssl->turtle_message + ssl->turtle_length, bytes, (word32)length);
+    ssl->turtle_length += (word32)length;
+    return 0;
+}
+int TurtleWolfBuild(WOLFSSL* ssl, int type)
+{
+    ssl->options.asyncState = TLS_ASYNC_BEGIN;
+    switch(type) {
+    case client_hello: return SendTls13ClientHello(ssl);
+    case server_hello: return SendTls13ServerHello(ssl, server_hello);
+    case encrypted_extensions: return SendTls13EncryptedExtensions(ssl);
+    case certificate_request: return SendTls13CertificateRequest(ssl, NULL, 0);
+    case certificate: return SendTls13Certificate(ssl);
+    case certificate_verify: return SendTls13CertificateVerify(ssl);
+    case finished: return SendTls13Finished(ssl);
+    default: return BAD_FUNC_ARG;
+    }
+}
+int TurtleWolfProcess(WOLFSSL* ssl, int type, byte* message, word32 length)
+{
+    word32 index = HANDSHAKE_HEADER_SZ;
+    byte extension = server_hello;
+    ssl->options.asyncState = TLS_ASYNC_BEGIN;
+    ssl->keys.padSz = 0;
+    switch(type) {
+    case client_hello: return DoTls13ClientHello(ssl, message, &index, length-4);
+    case server_hello: return DoTls13ServerHello(ssl, message, &index, length-4, &extension);
+    case encrypted_extensions: return DoTls13EncryptedExtensions(ssl, message, &index, length-4);
+    case certificate_request: return DoTls13CertificateRequest(ssl, message, &index, length-4);
+    case certificate: return DoTls13Certificate(ssl, message, &index, length-4);
+    case certificate_verify: return DoTls13CertificateVerify(ssl, message, &index, length-4);
+    case finished: return DoTls13Finished(ssl, message, &index, length-4, length, NO_SNIFF);
+    default: return BAD_FUNC_ARG;
+    }
+}
+int TurtleWolfCommit(WOLFSSL* ssl, int type, int outgoing)
+{
+    int ret = 0;
+    int server = ssl->options.side == WOLFSSL_SERVER_END;
+    if (type == client_hello && server) return DeriveEarlySecret(ssl);
+    if (type == server_hello) {
+        if (server) ret = TLSX_KeyShare_DeriveSecret(ssl);
+        else ret = DeriveEarlySecret(ssl);
+        if (ret == 0) ret = DeriveHandshakeSecret(ssl);
+        if (ret == 0) ret = DeriveTls13Keys(ssl, handshake_key, ENCRYPT_AND_DECRYPT_SIDE, 1);
+        if (ret == 0) ret = SetKeysSide(ssl, ENCRYPT_AND_DECRYPT_SIDE);
+        return ret;
+    }
+    if (type == finished) {
+        if (server == outgoing) {
+            ret = DeriveMasterSecret(ssl);
+            if (ret == 0) ret = DeriveTls13Keys(ssl, traffic_key, ENCRYPT_AND_DECRYPT_SIDE, 1);
+            if (ret == 0) ret = SetKeysSide(ssl, server ? ENCRYPT_SIDE_ONLY : DECRYPT_SIDE_ONLY);
+            if (server) ssl->options.serverState = SERVER_FINISHED_COMPLETE;
+        }
+        else {
+            ret = SetKeysSide(ssl, server ? DECRYPT_SIDE_ONLY : ENCRYPT_SIDE_ONLY);
+#if defined(HAVE_SESSION_TICKET) || !defined(NO_PSK)
+            if (ret == 0) ret = DeriveResumptionSecret(ssl, ssl->session->masterSecret);
+#endif
+            ssl->options.clientState = CLIENT_FINISHED_COMPLETE;
+        }
+    }
+    return ret;
+}
