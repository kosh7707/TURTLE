+int TurtleCiFinish(WOLFSSL* ssl)
+{
+    int ret=0;
+#ifdef WOLFSSL_SSC
+    if (ssl->options.side == WOLFSSL_SERVER_END) {
+        if (ssl->ssc_peer_support && ssl->options.verifyPeer)
+            ret=CI_SSC_MakeTicket(ssl, CI_CET_SSC_OBJECT, TRUE);
+    }
+    else if (ssl->ssc_peer_support && ssl->options.sendVerify)
+        ret=CI_SSC_MakeTicket(ssl, CACHED_INFO_TYPE_CERT, FALSE);
+#endif
+#ifdef WOLFSSL_CACHED_INFO
+    if (ret == 0 && ssl->options.side == WOLFSSL_CLIENT_END && !ssl->ci_cert_cache_hit_c && ssl->buffers.ciServerCertBuffer.buffer) {
+        ret=CI_AddServerCertChain(ssl->ctx,ssl->ci_peer_id,ssl->buffers.ciServerCertBuffer,DYNAMIC_TYPE_TLSX);
+        if(ret==0) {ssl->buffers.ciServerCertBuffer.buffer=NULL;ssl->buffers.ciServerCertBuffer.length=0;}
+    }
+#endif
+    return ret;
+}
