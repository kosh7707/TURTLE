+# TURTLE comparison: enable optimization only in the two ML-KEM translation units.
+# Assembly and CPUID support are compiled identically in both builds. AES, ECC,
+# SHA-256 and the generic SHA-3 objects keep the same build definitions.
+option(TURTLE_MLKEM_AVX2 "Use upstream ML-KEM AVX2 dispatch" OFF)
+if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+    message(FATAL_ERROR "This ML-KEM comparison pair is x86_64 only")
+endif()
+enable_language(ASM)
+target_sources(wolfssl PRIVATE wolfcrypt/src/wc_mlkem_asm.S wolfcrypt/src/sha3_asm.S)
+set(_turtle_mlkem_flags USE_INTEL_SPEEDUP HAVE_INTEL_AVX1 HAVE_INTEL_AVX2)
+if(NOT TURTLE_MLKEM_AVX2)
+    list(APPEND _turtle_mlkem_flags WC_MLKEM_NO_ASM)
+endif()
+set_source_files_properties(wolfcrypt/src/wc_mlkem.c wolfcrypt/src/wc_mlkem_poly.c
+    PROPERTIES COMPILE_DEFINITIONS "${_turtle_mlkem_flags}")
 add_library(wolfssl::wolfssl ALIAS wolfssl)
 
