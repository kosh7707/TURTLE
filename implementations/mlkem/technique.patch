+/* Full KEM API spans and actual polynomial dispatch use the connection callback. */
+static void turtle_kem_span(WOLFSSL* ssl, int op, int end, int type, int result)
+{
+    if (end && result == 0) {
+        if (op >= 6 && op <= 8) ssl->turtle_kem[op-6]++;
+        if (op >= 9 && op <= 11 && type == 2) ssl->turtle_kem[3]++;
+    }
+}
+static void turtle_kem_poly(void* context, int op, int end, int backend)
+{
+    turtle_kem_span((WOLFSSL*)context, op, end, backend, 0);
+}
+static void turtle_kem_attach(WOLFSSL* ssl, KyberKey* key)
+{
+#ifdef OPENSSL_EXTRA
+    key->turtle_trace = turtle_kem_poly;
+    key->turtle_trace_ctx = ssl;
+#endif
+}
+#endif
+
