+/* 스택에 소유한 생성 구간입니다. 레코드 처리나 I/O 전에 닫습니다. */
+typedef struct {
+    WOLFSSL* ssl;
+    int type;
+    int active;
+} TurtleGeneration;
+static void turtle_generation_begin(TurtleGeneration* span)
+{
+    if (!span->active) {
+        span->active = 1;
+        turtle_span(span->ssl, 0, 0, span->type, 0);
+    }
+}
+static void turtle_generation_end(TurtleGeneration* span, int result)
+{
+    if (span->active) {
+        turtle_span(span->ssl, 0, 1, span->type, result);
+        span->active = 0;
+    }
+}
+static int turtle_generation_return(TurtleGeneration* span, int result)
+{
+    turtle_generation_end(span, result);
+    return result;
+}
+static int turtle_send_after_generation(TurtleGeneration* span, WOLFSSL* ssl)
+{
+    turtle_generation_end(span, 0);
+    return SendBuffered(ssl);
+}
+
+void wolfSSL_turtle_enable_ping(WOLFSSL* ssl) { ssl->turtle_ping_enabled = 1; }
