+    return ssl != NULL && ssl->options.side == WOLFSSL_SERVER_END &&
+        ssl->options.tls1_3 && ssl->options.acceptState >= TLS13_ACCEPT_FINISHED_SENT &&
+        !ssl->options.handShakeDone;
+}
