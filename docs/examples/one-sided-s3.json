{
  "v": 1,
  "target": {
    "role": "client",
    "argv": [
      "gnutls-cli",
      "--logfile=/dev/stderr",
      "--priority=NORMAL:-VERS-ALL:+VERS-TLS1.3",
      "--verify-hostname={peer_name}",
      "--x509cafile={ca}",
      "--x509certfile={cert}",
      "--x509keyfile={key}",
      "--port={port}",
      "{host}"
    ]
  },
  "scenario": "S3",
  "auth": "mtls",
  "application": {"request": "ping", "response": "pong"},
  "warmups": 1,
  "repetitions": 2
}
