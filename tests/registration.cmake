cmake_minimum_required(VERSION 3.20)
if(NOT WORK OR NOT TURTLE_SOURCE)
    message(FATAL_ERROR "WORK and TURTLE_SOURCE required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source" "${WORK}/installed" "${WORK}/make/vendor")
get_filename_component(TURTLE_SOURCE "${TURTLE_SOURCE}" ABSOLUTE)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/commands.log" "${ARGV}\n${output}\n${error}\n")
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Registration command failed: ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
file(WRITE "${WORK}/native.c" "int fixture_value(void) { return 42; }\n")
find_program(CC NAMES cc gcc clang REQUIRED)
find_program(AR ar REQUIRED)
find_program(MAKE make REQUIRED)
run("${CC}" -c "${WORK}/native.c" -o "${WORK}/native.o")
run("${AR}" rcs "${WORK}/libfixture.a" "${WORK}/native.o")
set(probe "#include <turtle/implementation.h>\nextern \"C\" int fixture_value(void);\nint main(){static_assert(TURTLE_CLIENT!=TURTLE_SERVER);return fixture_value()==42?0:1;}\n")
file(WRITE "${WORK}/source/main.cpp" "${probe}")
file(WRITE "${WORK}/source/native.c" "int fixture_value(void) { return 42; }\n")
file(WRITE "${WORK}/source/CMakeLists.txt" "add_library(fixture_source STATIC native.c)\nadd_executable(probe_source main.cpp)\ntarget_link_libraries(probe_source PRIVATE turtle::contract fixture_source)\nset_target_properties(probe_source PROPERTIES RUNTIME_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}\")\n")
file(WRITE "${WORK}/installed/main.cpp" "${probe}")
file(WRITE "${WORK}/installed/CMakeLists.txt" "add_library(fixture_installed STATIC IMPORTED)\nset_target_properties(fixture_installed PROPERTIES IMPORTED_LOCATION \"${WORK}/libfixture.a\")\nadd_executable(probe_installed main.cpp)\ntarget_link_libraries(probe_installed PRIVATE turtle::contract fixture_installed)\nset_target_properties(probe_installed PROPERTIES RUNTIME_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}\")\n")
file(WRITE "${WORK}/make/main.cpp" "${probe}")
file(WRITE "${WORK}/make/vendor/native.c" "int fixture_value(void) { return 42; }\n")
file(WRITE "${WORK}/make/vendor/Makefile" "all:\n\t$(CC) -c \"$(SOURCE_DIR)/native.c\" -o native.o\n\t$(AR) rcs libfixture.a native.o\n")
file(WRITE "${WORK}/make/CMakeLists.txt" "include(ExternalProject)\nExternalProject_Add(fixture_make_build SOURCE_DIR \"\${CMAKE_CURRENT_SOURCE_DIR}/vendor\" BINARY_DIR \"\${CMAKE_CURRENT_BINARY_DIR}/native\" DOWNLOAD_COMMAND \"\" UPDATE_COMMAND \"\" CONFIGURE_COMMAND \"\" INSTALL_COMMAND \"\" BUILD_COMMAND \"${MAKE}\" -f <SOURCE_DIR>/Makefile SOURCE_DIR=<SOURCE_DIR> CC=\${CMAKE_C_COMPILER} AR=\${CMAKE_AR} BUILD_BYPRODUCTS <BINARY_DIR>/libfixture.a)\nadd_library(fixture_make STATIC IMPORTED)\nset_target_properties(fixture_make PROPERTIES IMPORTED_LOCATION \"\${CMAKE_CURRENT_BINARY_DIR}/native/libfixture.a\")\nadd_dependencies(fixture_make fixture_make_build)\nadd_executable(probe_make main.cpp)\ntarget_link_libraries(probe_make PRIVATE turtle::contract fixture_make)\nset_target_properties(probe_make PROPERTIES RUNTIME_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}\")\n")
# A native C contract also links the common endpoint entrypoint.
configure_file("${TURTLE_SOURCE}/tests/contract.c" "${WORK}/source/contract.c" COPYONLY)
file(APPEND "${WORK}/source/CMakeLists.txt" "add_executable(probe_contract contract.c)\ntarget_link_libraries(probe_contract PRIVATE turtle::endpoint)\nset_target_properties(probe_contract PROPERTIES RUNTIME_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}\")\n")
# Use a generated preload file so semicolons remain one cache value.
file(WRITE "${WORK}/options.cmake" "set(TURTLE_IMPLEMENTATION_DIRS \"${WORK}/source;${WORK}/installed;${WORK}/make\" CACHE STRING \"\")\nset(CMAKE_PREFIX_PATH \"${DEPENDENCY_PREFIX}\" CACHE STRING \"\")\n")
run("${CMAKE_COMMAND}" -S "${TURTLE_SOURCE}" -B "${WORK}/build" -G Ninja -C "${WORK}/options.cmake" -DCMAKE_BUILD_TYPE=Release)
run("${CMAKE_COMMAND}" --build "${WORK}/build" --target probe_source probe_installed probe_make probe_contract --parallel 2)
foreach(probe source installed make contract)
    run("${WORK}/build/probe_${probe}")
endforeach()
file(READ "${WORK}/build/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
    string(JSON source GET "${commands}" ${i} file)
    if(source MATCHES "${WORK}/(source|installed|make)/main.cpp$")
        string(JSON command GET "${commands}" ${i} command)
        if(command MATCHES "-I${TURTLE_SOURCE}/src")
            message(FATAL_ERROR "Internal headers leaked to implementation")
        endif()
    endif()
endforeach()
message(STATUS "External source, installed library, Make and C contract registration passed")
