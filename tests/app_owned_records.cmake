cmake_minimum_required(VERSION 3.20)
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGV}: ${rc}\n${output}\n${error}")
  endif()
endfunction()
string(RANDOM LENGTH 10 tag)
set(w "${WORK}/${tag}")
file(MAKE_DIRECTORY "${w}/source")
configure_file("${CMAKE_CURRENT_LIST_DIR}/app_owned_client.cpp" "${w}/source/main.cpp" COPYONLY)
file(WRITE "${w}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(external_native_client LANGUAGES C CXX)
find_package(TURTLE CONFIG REQUIRED)
find_package(OpenSSL REQUIRED)
add_executable(owned main.cpp)
target_link_libraries(owned PRIVATE turtle::endpoint OpenSSL::SSL)
]=])
run("${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${w}/sdk")
run("${CMAKE_COMMAND}" -S "${w}/source" -B "${w}/build" "-DCMAKE_PREFIX_PATH=${w}/sdk" "-DOPENSSL_ROOT_DIR=${SSLROOT}")
run("${CMAKE_COMMAND}" --build "${w}/build")
if(CAPTURE_ONLY)
  file(WRITE "${w}/capture-spec.json" "{\"v\":1,\"target\":{\"role\":\"client\",\"argv\":[\"${w}/build/owned\",\"bytes-only\"]},\"scenario\":\"S3\",\"auth\":\"mtls\",\"network\":\"netem\",\"netem\":{},\"warmups\":0,\"repetitions\":1,\"recording\":\"detailed\",\"required_metrics\":[\"capture\"]}")
  foreach(trial good unrelated)
    run("${CLI}" run "${w}/capture-spec.json" "${w}/${trial}")
  endforeach()
  function(verify_capture dir expected eligible)
    file(READ "${dir}/analysis.json" summary)
    string(JSON actual GET "${summary}" eligible_measurements)
    file(READ "${dir}/attempts/00000/analysis.json" attempt)
    string(JSON capture GET "${attempt}" observations capture availability)
    string(JSON records GET "${attempt}" observations records availability)
    string(JSON layout GET "${attempt}" observations record_layout availability)
    string(JSON flight GET "${attempt}" observations tls_flights CH availability)
    if(NOT actual EQUAL eligible OR NOT capture STREQUAL expected OR records STREQUAL "available" OR flight STREQUAL "available" OR NOT layout STREQUAL "available")
      message(FATAL_ERROR "Wrong independent PCAP/record qualification: ${actual},${capture},${records},${flight},${layout} (${dir})")
    endif()
  endfunction()
  verify_capture("${w}/good" available 1)
  set(pcap "${w}/good/attempts/00000/client.pcap")
  file(RENAME "${pcap}" "${w}/original.pcap")
  configure_file("${w}/good/manifest.json" "${w}/original-manifest.json" COPYONLY)
  foreach(fault missing unrelated)
    if(fault STREQUAL "unrelated")
      configure_file("${w}/unrelated/attempts/00000/client.pcap" "${pcap}" COPYONLY)
      # Isolate the TCP proof: even with this disposable fixture repinned to the
      # replacement PCAP, a different TLS connection cannot match these bytes.
      file(SHA256 "${pcap}" h)
      file(READ "${w}/original-manifest.json" manifest)
      string(JSON manifest SET "${manifest}" attempts 0 artifacts_sha256 client.pcap "\"${h}\"")
      file(WRITE "${w}/good/manifest.json" "${manifest}")
    endif()
    execute_process(COMMAND "${CLI}" analyze "${w}/good" RESULT_VARIABLE rc)
    if(rc EQUAL 0)
      message(FATAL_ERROR "${fault} PCAP qualified")
    endif()
    if(fault STREQUAL "missing")
      file(READ "${w}/good/attempts/00000/analysis.json" attempt)
      string(JSON reasons GET "${attempt}" invalid_reasons)
      if(NOT reasons MATCHES "raw_artifact_missing")
        message(FATAL_ERROR "Missing file did not fail integrity verification: ${reasons}")
      endif()
    else()
      verify_capture("${w}/good" missing 0)
      file(READ "${w}/good/attempts/00000/analysis.json" attempt)
      string(JSON reason GET "${attempt}" observations capture reason)
      if(NOT reason MATCHES "mismatch")
        message(FATAL_ERROR "Unrelated PCAP failed for the wrong reason: ${reason}")
      endif()
    endif()
    configure_file("${w}/good/attempts/00000/analysis.json" "${w}/${fault}-capture-evidence.json" COPYONLY)
  endforeach()
  file(RENAME "${w}/original.pcap" "${pcap}")
  configure_file("${w}/original-manifest.json" "${w}/good/manifest.json" COPYONLY)
  run("${CLI}" analyze "${w}/good")
  verify_capture("${w}/good" available 1)
  message(STATUS "Verified byte-only native mTLS/PCAP qualifying without record clocks; missing/wrong traces rejected: ${w}")
  return()
endif()
run(sh "${CMAKE_CURRENT_LIST_DIR}/../examples/issue-test-leaves.sh" "${w}/certs")
set(ENV{TURTLE_CERT} "${w}/certs/client.crt")
set(ENV{TURTLE_KEY} "${w}/certs/client.key")
set(ENV{TURTLE_CA} "${w}/certs/ca.crt")
foreach(mode intervals bytes-only)
  if(mode STREQUAL "intervals")
    set(args "")
  else()
    set(args "\"bytes-only\"")
  endif()
  file(WRITE "${w}/spec.json" "{\"network\":\"loopback\",\"warmups\":0,\"repetitions\":1,\"configurations\":[{\"id\":\"owned\",\"scenario\":\"S3\",\"auth\":\"mtls\",\"measured_role\":\"client\",\"recording\":\"detailed\",\"record_contract\":\"flight-boundaries.v1\",\"required_metrics\":[\"records\"],\"client\":{\"binary\":\"${w}/build/owned\",\"args\":[${args}]},\"server\":{\"binary\":\"${SERVER}\",\"args\":[\"--cert\",\"${w}/certs/server.crt\",\"--key\",\"${w}/certs/server.key\",\"--ca\",\"${w}/certs/ca.crt\"]}}]}")
  execute_process(COMMAND "${CLI}" run "${w}/spec.json" "${w}/${mode}" RESULT_VARIABLE rc)
  file(READ "${w}/${mode}/attempts/00000/analysis.json" attempt)
  string(JSON record_status GET "${attempt}" observations records availability)
  string(JSON layout_status GET "${attempt}" observations record_layout availability)
  if(NOT layout_status STREQUAL "available")
    message(FATAL_ERROR "Complete byte stream lost its independent layout")
  endif()
  foreach(direction send receive)
    string(JSON row GET "${attempt}" observations record_layout value ${direction} 0)
    string(JSON lo GET "${row}" wire_begin)
    string(JSON hi GET "${row}" wire_end)
    string(JSON body GET "${row}" body_bytes)
    math(EXPR size "${body}+5")
    if(NOT lo EQUAL 0 OR NOT hi EQUAL size OR row MATCHES "socket_ranges|public_io_ranges|wall_ns|timestamp")
      message(FATAL_ERROR "Layout must contain only independently derived byte ranges")
    endif()
  endforeach()
  string(JSON public_status GET "${attempt}" observations public_io availability)
  if(public_status STREQUAL "available")
    message(FATAL_ERROR "A socket interval was mislabeled as public TLS I/O")
  endif()
  if(mode STREQUAL "intervals")
    if(NOT record_status STREQUAL "available")
      message(FATAL_ERROR "Record evidence unavailable")
    endif()
    set(sends 0)
    set(receives 0)
    file(STRINGS "${w}/intervals/attempts/00000/client/events.jsonl" events)
    foreach(event IN LISTS events)
      string(JSON kind GET "${event}" kind)
      if(kind STREQUAL "socket")
        string(JSON direction GET "${event}" direction)
        string(JSON n GET "${event}" transferred)
        if(direction STREQUAL "send")
          math(EXPR sends "${sends}+1")
        elseif(n GREATER 0)
          math(EXPR receives "${receives}+1")
        endif()
        if(n GREATER 19)
          message(FATAL_ERROR "Lower fragmentation lost")
        endif()
      endif()
    endforeach()
    file(READ "${w}/intervals/attempts/00000/client/endpoint.json" ep)
    string(JSON hook_sends GET "${ep}" collection transport_hooks send_attempts)
    string(JSON hook_receives GET "${ep}" collection transport_hooks positive_receives)
    if(NOT sends EQUAL hook_sends OR NOT receives EQUAL hook_receives OR sends LESS 5 OR receives LESS 5)
      message(FATAL_ERROR "Socket trace and independent count hook disagree")
    endif()
  else()
    string(JSON reason GET "${attempt}" observations records reason)
    if(NOT record_status STREQUAL "missing" OR NOT reason STREQUAL "socket_trace_incomplete")
      message(FATAL_ERROR "Byte-only evidence rejected for the wrong reason: ${reason}")
    endif()
  endif()
  file(READ "${w}/${mode}/analysis.json" report)
  string(JSON eligible GET "${report}" eligible_measurements)
  if(mode STREQUAL "intervals")
    if(NOT eligible EQUAL 1 OR NOT rc EQUAL 0)
      message(FATAL_ERROR "Real fragmented socket intervals did not qualify: ${w}")
    endif()
  elseif(NOT eligible EQUAL 0)
    message(FATAL_ERROR "Byte-only notice fabricated record timing: ${w}")
  endif()
endforeach()
# The compact developer contract also enforces real thread PMU, per-exec
# provenance and authenticated role completion before records may qualify.
file(WRITE "${w}/strict.json" "{\"v\":1,\"target\":{\"role\":\"client\",\"argv\":[\"${w}/build/owned\"]},\"scenario\":\"S3\",\"auth\":\"mtls\",\"warmups\":0,\"repetitions\":1,\"recording\":\"detailed\",\"required_metrics\":[\"records\"]}")
execute_process(COMMAND "${CLI}" check "${w}/strict.json" RESULT_VARIABLE checked OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT checked EQUAL 0 AND out MATCHES "required_metric_unavailable:perf_counters" AND NOT out MATCHES "endpoint_check_failed")
  message(STATUS "Strict pass unavailable: actual PMU denied. Real socket/byte-only pair tests passed.")
else()
  run("${CLI}" run "${w}/strict.json" "${w}/strict")
  file(READ "${w}/strict/analysis.json" report)
  string(JSON eligible GET "${report}" eligible_measurements)
  if(NOT eligible EQUAL 1)
    message(FATAL_ERROR "External socket was not eligible under compact v1: ${w}")
  endif()
endif()
message(STATUS "Independent app-owned native TLS records and byte-only negative: ${w}")
