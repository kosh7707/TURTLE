if(NOT ROOT)
    message(FATAL_ERROR "ROOT required")
endif()
file(GLOB_RECURSE public_headers "${ROOT}/src/include/turtle/*")
if(NOT public_headers)
    message(FATAL_ERROR "Public SDK headers missing under src/include/turtle")
endif()
foreach(path IN LISTS public_headers)
    file(READ "${path}" text)
    if(text MATCHES "nlohmann|pcap|#include [\"<](src|measure|frame|analysis|control|process)/")
        message(FATAL_ERROR "Implementation contract exposes internals: ${path}")
    endif()
endforeach()
file(GLOB_RECURSE sources "${ROOT}/src/*.cpp" "${ROOT}/src/*.hpp")
foreach(path IN LISTS sources)
    file(READ "${path}" text)
    if(text MATCHES "turtlebench|TURTLE-legacy|/home/|python[0-9]*|tcpdump|openssl/|wolfssl/")
        # The dependency audit may name libpython, but never invokes it.
        string(REPLACE "libpython" "" checked "${text}")
        if(checked MATCHES "turtlebench|TURTLE-legacy|/home/|python[0-9]*|tcpdump|openssl/|wolfssl/")
            message(FATAL_ERROR "Forbidden framework dependency: ${path}")
        endif()
    endif()
    file(RELATIVE_PATH relative "${ROOT}/src" "${path}")
    string(REGEX REPLACE "/.*" "" component "${relative}")
    string(REGEX MATCHALL "#include \"[a-z_]+/[^\"]+\"" includes "${text}")
    foreach(include IN LISTS includes)
        string(REGEX REPLACE "#include \"([^/]+)/.*" "\\1" dependency "${include}")
        if(NOT component STREQUAL dependency)
            list(APPEND "deps_${component}" "${dependency}")
        endif()
    endforeach()
    list(APPEND components "${component}")
endforeach()
list(REMOVE_DUPLICATES components)
function(visit component ancestors)
    if(component IN_LIST ancestors)
        message(FATAL_ERROR "Component dependency cycle: ${ancestors};${component}")
    endif()
    list(APPEND ancestors "${component}")
    foreach(dependency IN LISTS "deps_${component}")
        visit("${dependency}" "${ancestors}")
    endforeach()
endfunction()
cmake_policy(SET CMP0057 NEW)
foreach(component IN LISTS components)
    visit("${component}" "")
endforeach()
set(path "${ROOT}/implementations/implementation.cpp")
if(EXISTS "${path}")
    file(READ "${path}" text)
    if(text MATCHES "#include [\"<](\\.\\./)*(src|measure|frame|net|run|artifact|analysis|control|process|native|submission)/")
        message(FATAL_ERROR "Submission uses internal header: ${path}")
    endif()
endif()
file(GLOB submission_forbidden "${ROOT}/implementations/*.py")
file(GLOB_RECURSE forbidden "${ROOT}/src/*.py" "${ROOT}/tests/*.py")
if(forbidden OR submission_forbidden OR EXISTS "${ROOT}/python" OR EXISTS "${ROOT}/bin/turtle")
    message(FATAL_ERROR "Python remains in framework or mandatory tests")
endif()
message(STATUS "Public contract and acyclic component boundaries passed")
