cmake_minimum_required(VERSION 3.20)
# Native host bootstrap. Never fetch implicitly during framework configuration.
if(NOT NAME OR NOT VERSION)
    message(FATAL_ERROR "Use cmake -DNAME=<dependency> -DVERSION=<version> -P tools/dependencies.cmake")
endif()
if(NOT DEPS_DIR)
    set(DEPS_DIR "${CMAKE_CURRENT_LIST_DIR}/../.deps")
endif()
get_filename_component(DEPS_DIR "${DEPS_DIR}" ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" manifest)
string(JSON count LENGTH "${manifest}" sources)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
    string(JSON entry GET "${manifest}" sources ${i})
    string(JSON name GET "${entry}" name)
    string(JSON version GET "${entry}" version)
    if(name STREQUAL NAME AND version STREQUAL VERSION)
        set(selected "${entry}")
        break()
    endif()
endforeach()
if(NOT selected)
    message(FATAL_ERROR "Not in the pinned dependency manifest: ${NAME} ${VERSION}")
endif()
foreach(key archive sha256 url)
    string(JSON ${key} GET "${selected}" ${key})
endforeach()
set(id "${NAME}-${VERSION}")
set(prepared "${DEPS_DIR}/prepared/${id}")
set(archive "${DEPS_DIR}/cache/${archive}")
file(MAKE_DIRECTORY "${DEPS_DIR}/cache" "${prepared}")
file(LOCK "${prepared}/bootstrap.lock" GUARD PROCESS TIMEOUT 120)
if(NOT EXISTS "${archive}")
    if(OFFLINE)
        message(FATAL_ERROR "Offline: missing ${archive}")
    endif()
    file(DOWNLOAD "${url}" "${archive}.part" TLS_VERIFY ON
        EXPECTED_HASH "SHA256=${sha256}" STATUS status SHOW_PROGRESS)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Download failed: ${status}")
    endif()
    file(RENAME "${archive}.part" "${archive}")
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL sha256)
    message(FATAL_ERROR "SHA256 mismatch: ${archive}")
endif()
if(FETCH_ONLY)
    message(STATUS "Verified ${archive}")
    return()
endif()
set(work "${prepared}/bootstrap-work")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/src" "${work}/build")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}/src")
file(GLOB roots LIST_DIRECTORIES true "${work}/src/*")
list(LENGTH roots roots_count)
if(NOT roots_count EQUAL 1 OR NOT IS_DIRECTORY "${roots}")
    message(FATAL_ERROR "Expected one top-level source directory in pinned archive")
endif()
string(JSON n LENGTH "${selected}" build_options)
math(EXPR end "${n}-1")
foreach(i RANGE 0 ${end})
    string(JSON opt GET "${selected}" build_options ${i})
    list(APPEND opts "${opt}")
endforeach()
set(prefix "${prepared}/install")
if(NOT DEFINED JOBS)
    set(JOBS 2)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be a positive integer")
endif()
if(NAME STREQUAL "openssl" OR NAME STREQUAL "linux")
    find_program(MAKE NAMES gmake make REQUIRED)
    if(NAME STREQUAL "openssl")
        execute_process(COMMAND "${roots}/Configure" "--prefix=${prefix}" ${opts}
            WORKING_DIRECTORY "${work}/build" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${MAKE}" "-j${JOBS}" WORKING_DIRECTORY "${work}/build" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${MAKE}" install_sw WORKING_DIRECTORY "${work}/build" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${MAKE}" -C "${roots}/tools/perf" "-j${JOBS}"
            "O=${work}/build" "prefix=${prefix}" ${opts} install-bin COMMAND_ERROR_IS_FATAL ANY)
    endif()
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${roots}" -B "${work}/build"
        "-DCMAKE_INSTALL_PREFIX=${prefix}" ${opts} COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/build" --parallel "${JOBS}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${work}/build" COMMAND_ERROR_IS_FATAL ANY)
endif()
message(STATUS "Prepared ${prefix}")
