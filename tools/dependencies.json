{
  "schema": "turtle.dependencies.v2",
  "sources": [
    {
      "name": "openssl",
      "version": "3.5.9",
      "url": "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz",
      "archive": "openssl-3.5.9.tar.gz",
      "reason": "Reference TLS 1.3 build and the default provider's ML-KEM and ML-DSA support",
      "sha256": "603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a",
      "component": "tls",
      "build_options": [
        "--release",
        "shared",
        "--libdir=lib"
      ]
    },
    {
      "name": "openssl",
      "version": "3.5.5",
      "url": "https://github.com/openssl/openssl/releases/download/openssl-3.5.5/openssl-3.5.5.tar.gz",
      "archive": "openssl-3.5.5.tar.gz",
      "reason": "Version substitution and static-link checks using the same public integration source",
      "sha256": "b28c91532a8b65a1f983b4c28b7488174e4a01008e29ce8e69bd789f28bc2a89",
      "component": "tls",
      "build_options": [
        "--release",
        "no-shared",
        "--libdir=lib"
      ]
    },
    {
      "name": "wolfssl",
      "version": "5.9.4",
      "url": "https://codeload.github.com/wolfSSL/wolfssl/tar.gz/refs/tags/v5.9.4-stable",
      "archive": "wolfssl-5.9.4.tar.gz",
      "reason": "Optional wolfSSL build with public I/O callbacks",
      "sha256": "7256bfc89b183a75183806c7debfa203443873b0b4a562e1b80d68e01b45ac57",
      "component": "tls",
      "build_options": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=OFF",
        "-DWOLFSSL_MLKEM=yes",
        "-DWOLFSSL_MLDSA=yes",
        "-DWOLFSSL_TLS_NO_MLKEM_STANDALONE=no",
        "-DWOLFSSL_CURVE25519=yes",
        "-DWOLFSSL_SNI=yes",
        "-DWOLFSSL_EXAMPLES=no",
        "-DWOLFSSL_CRYPT_TESTS=no"
      ]
    },
    {
      "name": "json",
      "version": "3.12.0",
      "component": "framework",
      "archive": "json-3.12.0.tar.xz",
      "url": "https://github.com/nlohmann/json/releases/download/v3.12.0/json.tar.xz",
      "sha256": "42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa",
      "license": "MIT",
      "reason": "JSON and JSONL I/O outside the measured interval with 64-bit integer preservation",
      "build_options": [
        "-DJSON_BuildTests=OFF"
      ]
    },
    {
      "name": "libpcap",
      "version": "1.10.6",
      "component": "framework",
      "archive": "libpcap-1.10.6.tar.xz",
      "url": "https://www.tcpdump.org/release/libpcap-1.10.6.tar.xz",
      "sha256": "ec97d1206bdd19cb6bdd043eaa9f0037aa732262ec68e070fd7c7b5f834d5dfc",
      "license": "BSD-3-Clause",
      "reason": "Per-endpoint packet capture and classic pcap decoding",
      "build_options": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=OFF",
        "-DDISABLE_DBUS=ON",
        "-DDISABLE_BLUETOOTH=ON",
        "-DDISABLE_USB=ON",
        "-DDISABLE_RDMA=ON",
        "-DDISABLE_NETMAP=ON",
        "-DBUILD_WITH_LIBNL=OFF"
      ]
    },
    {
      "name": "linux",
      "version": "7.0.14",
      "component": "perf",
      "archive": "linux-7.0.14.tar.xz",
      "url": "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.0.14.tar.xz",
      "sha256": "de9999b784d2293f00d39c62d8f92a08ab8a54bc4e80ffd250a0c09cb07a0f98",
      "license": "GPL-2.0 (perf), see source licenses",
      "reason": "Upstream perf record/script and symbol information without Python bindings",
      "build_options": [
        "NO_LIBPYTHON=1",
        "NO_LIBPERL=1",
        "NO_LIBBPF=1",
        "NO_LIBTRACEEVENT=1",
        "NO_LIBNUMA=1",
        "NO_SLANG=1",
        "NO_LIBBABELTRACE=1",
        "NO_LIBPFM4=1",
        "NO_LIBDEBUGINFOD=1",
        "WERROR=0"
      ]
    }
  ],
  "runtime_tools": [
    "ip",
    "tc",
    "ethtool",
    "sysctl",
    "sha256sum",
    "readelf",
    "ldd"
  ],
  "optional_validation_tools": [
    "TShark/Wireshark",
    "clang-tidy",
    "bubblewrap"
  ],
  "platform": "Linux; ARM64 considered"
}
