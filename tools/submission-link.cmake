cmake_minimum_required(VERSION 3.20)
set(prefix "${JOB}/prefix")
set(submission "${ROOT}/implementations")
foreach(path IN ITEMS "${ROOT}" "${FRAMEWORK}" "${JOB}")
    if(path MATCHES "[;:\r\n]")
        message(FATAL_ERROR "Submission paths cannot contain a semicolon, colon, or newline")
    endif()
endforeach()
find_program(pkgconf NAMES pkg-config REQUIRED)
find_program(readelf NAMES readelf REQUIRED)
file(STRINGS "${FRAMEWORK}/CMakeCache.txt" compiler_line REGEX "^CMAKE_CXX_COMPILER:[^=]+=.+$")
string(REGEX REPLACE "^[^=]+=" "" compiler "${compiler_line}")
if(NOT IS_ABSOLUTE "${compiler}" OR NOT EXISTS "${compiler}")
    message(FATAL_ERROR "Could not locate the framework C++ compiler in ${FRAMEWORK}/CMakeCache.txt")
endif()

function(command out log)
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.argv" "[${arg}]\n")
    endforeach()
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    file(WRITE "${log}" "${stdout}\n${stderr}")
    file(WRITE "${log}.exit" "${rc}\n")
    set(${out} "${rc}" PARENT_SCOPE)
    set(output "${stdout}" PARENT_SCOPE)
    set(diagnostics "${stderr}" PARENT_SCOPE)
endfunction()

# Only a complete, known GNU missing-symbol diagnosis rules out a module.
# Mixed/unknown diagnostics (I/O, signals, other linkers) are inconclusive.
function(missing_symbols out rc stdout stderr)
    set(${out} FALSE PARENT_SCOPE)
    if(NOT rc STREQUAL "1" OR NOT stdout STREQUAL "")
        return()
    endif()
    set(ld "^([^:]+/)?([^/:]+-)?ld(\\.bfd)?: ")
    string(REPLACE "\n" ";" lines "${stderr}")
    set(missing FALSE)
    set(context FALSE)
    foreach(line IN LISTS lines)
        if(line STREQUAL "" OR line STREQUAL "collect2: error: ld returned 1 exit status")
            continue()
        elseif(line MATCHES "${ld}.+: in function .+:$")
            set(context TRUE)
        elseif(line MATCHES "${ld}.+: undefined reference to .+$")
            set(missing TRUE)
            set(context FALSE)
        elseif(context AND line MATCHES "^.+:\\(.+\\): undefined reference to .+$")
            set(missing TRUE)
            set(context FALSE)
        elseif(NOT line MATCHES "${ld}.+: error adding symbols: DSO missing from command line$")
            return()
        endif()
    endforeach()
    set(${out} "${missing}" PARENT_SCOPE)
endfunction()

function(pc out log)
    command(rc "${log}" "${CMAKE_COMMAND}" -E env --unset=PKG_CONFIG_LIBDIR --unset=PKG_CONFIG_SYSROOT_DIR
        --unset=PKG_CONFIG_TOP_BUILD_DIR "PKG_CONFIG_PATH=${pc_path}" "${pkgconf}" ${ARGN})
    set(${out} "${rc}" PARENT_SCOPE)
    set(output "${output}" PARENT_SCOPE)
endfunction()

function(arguments out raw)
    string(REPLACE "${prefix}" "@TURTLE_PREFIX@" scrubbed "${raw}")
    separate_arguments(tokens UNIX_COMMAND "${scrubbed}")
    string(REPLACE "@TURTLE_PREFIX@" "${prefix}" tokens "${tokens}")
    set(${out} "${tokens}" PARENT_SCOPE)
endfunction()

function(within out dir target)
    if(NOT EXISTS "${target}")
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    file(REAL_PATH "${target}" real)
    cmake_path(IS_PREFIX dir "${real}" NORMALIZE contained)
    if(contained)
        set(${out} "${real}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

function(consume name record)
    set(dir "${SCAN}/${name}")
    file(MAKE_DIRECTORY "${dir}")
    pc(rc "${dir}/metadata.log" --variable=pcfiledir "${name}")
    if(NOT rc EQUAL 0)
        set(${record} "unresolved metadata; see ${dir}/metadata.log" PARENT_SCOPE)
        return()
    endif()
    string(REPLACE "\\ " " " output "${output}")
    within(resolved "${prefix}" "${output}/${name}.pc")
    if(NOT resolved STREQUAL "${pc_file_${name}}")
        set(${record} "module does not resolve to the submitted .pc file" PARENT_SCOPE)
        return()
    endif()
    pc(rc "${dir}/cflags.log" --cflags "${name}")
    if(NOT rc EQUAL 0)
        set(${record} "unresolved compiler options; see ${dir}/cflags.log" PARENT_SCOPE)
        return()
    endif()
    arguments(cflags "${output}")
    set(stage_include FALSE)
    foreach(flag IN LISTS cflags)
        if(flag MATCHES "^-I(.+)$")
            within(inc "${prefix}" "${CMAKE_MATCH_1}")
            if(inc)
                set(stage_include TRUE)
            endif()
        elseif(NOT flag MATCHES "^(-[DU].+|-pthread)$")
            set(${record} "unsupported public compiler option: ${flag}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    if(NOT stage_include)
        set(${record} "no private include directory was declared" PARENT_SCOPE)
        return()
    endif()
    pc(rc "${dir}/libs.log" --libs "${name}")
    if(NOT rc EQUAL 0)
        set(${record} "unresolved link options; see ${dir}/libs.log" PARENT_SCOPE)
        return()
    endif()
    if(prefix MATCHES " ")
        string(REPLACE " " "\\ " escaped "${prefix}")
        string(FIND "${output}" "${prefix}" literal_position)
        string(FIND "${output}" "${escaped}" escaped_position)
        if(literal_position LESS 0 AND escaped_position LESS 0)
            pc(rc "${dir}/libs-relocated.log" --define-prefix --libs "${name}")
            if(NOT rc EQUAL 0)
                set(${record} "could not resolve quoted install paths; see ${dir}/libs-relocated.log" PARENT_SCOPE)
                return()
            endif()
        endif()
    endif()
    arguments(lflags "${output}")
    set(libdirs "")
    foreach(flag IN LISTS lflags)
        if(flag MATCHES "^-L(.+)$")
            within(libdir "${prefix}" "${CMAKE_MATCH_1}")
            if(NOT IS_DIRECTORY "${libdir}")
                set(${record} "library search directory is not in the staged TLS install: ${flag}" PARENT_SCOPE)
                return()
            endif()
            list(APPEND libdirs "${libdir}")
        endif()
    endforeach()
    set(inputs "")
    set(sonames "")
    set(soname_paths "")
    foreach(flag IN LISTS lflags)
        if(flag MATCHES "^-L")
            continue()
        elseif(flag STREQUAL "-pthread")
            list(APPEND inputs "${flag}")
            continue()
        elseif(flag MATCHES "^-l([a-zA-Z0-9_.+-]+)$")
            set(libfile "lib${CMAKE_MATCH_1}.so")
            set(input "")
            foreach(libdir IN LISTS libdirs)
                if(EXISTS "${libdir}/${libfile}")
                    within(input "${prefix}" "${libdir}/${libfile}")
                    break()
                endif()
            endforeach()
        elseif(IS_ABSOLUTE "${flag}")
            within(input "${prefix}" "${flag}")
        else()
            set(${record} "unsupported public link option: ${flag}" PARENT_SCOPE)
            return()
        endif()
        if(NOT input)
            set(${record} "no private shared library for ${flag}" PARENT_SCOPE)
            return()
        endif()
        get_filename_component(libdir "${input}" DIRECTORY)
        list(APPEND libdirs "${libdir}")
        execute_process(COMMAND "${readelf}" -dW "${input}" RESULT_VARIABLE rc OUTPUT_VARIABLE dynamic ERROR_QUIET)
        if(NOT rc EQUAL 0 OR NOT dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
            set(${record} "expected an ELF shared library with a SONAME: ${input}" PARENT_SCOPE)
            return()
        endif()
        set(soname "${CMAKE_MATCH_1}")
        list(FIND sonames "${soname}" index)
        if(index GREATER_EQUAL 0)
            list(GET soname_paths "${index}" duplicate)
            if(NOT duplicate STREQUAL input)
                set(${record} "private shared libraries disagree on SONAME ${soname}" PARENT_SCOPE)
                return()
            endif()
        else()
            list(APPEND sonames "${soname}")
            list(APPEND soname_paths "${input}")
        endif()
        list(APPEND inputs "${input}")
    endforeach()
    if(NOT sonames)
        set(${record} "no private shared library input" PARENT_SCOPE)
        return()
    endif()

    string(SHA256 compile_id "${cflags}")
    set(objdir "${SCAN}/objects/${compile_id}")
    set(obj "${objdir}/implementation.o")
    if(NOT EXISTS "${objdir}/ready")
        file(MAKE_DIRECTORY "${objdir}")
        command(rc "${objdir}/compile.log" "${compiler}" -std=c++17 -O2 "-I${ROOT}/src/include" ${cflags}
            -MD -MF "${objdir}/implementation.d" -c "${submission}/implementation.cpp" -o "${obj}")
        if(NOT rc EQUAL 0)
            set(${record} "bridge compilation failed; see ${objdir}/compile.log" PARENT_SCOPE)
            return()
        endif()
        file(READ "${objdir}/implementation.d" deps)
        string(REPLACE "\\ " " " deps "${deps}")
        string(FIND "${deps}" "${prefix}/" private_dep)
        if(private_dep LESS 0)
            set(${record} "no staged TLS header observed in ${objdir}/implementation.d" PARENT_SCOPE)
            return()
        endif()
        file(TOUCH "${objdir}/ready")
    endif()

    list(REMOVE_DUPLICATES libdirs)
    list(JOIN libdirs ":" rpath_link)
    set(plan "")
    foreach(role IN ITEMS client server)
        set(binary "${dir}/${role}")
        command(rc "${dir}/${role}.link.log" "${compiler}" "${FRAMEWORK}/submission-${role}.o" "${obj}"
            -Xlinker -Map -Xlinker "${dir}/${role}.map"
            -Xlinker --as-needed -Xlinker --disable-new-dtags
            -Xlinker -rpath -Xlinker "${rpath_link}" -Xlinker -rpath-link -Xlinker "${rpath_link}"
            "${FRAMEWORK}/libturtle_measure.a" ${inputs} -o "${binary}")
        if(NOT rc EQUAL 0)
            missing_symbols(missing "${rc}" "${output}" "${diagnostics}")
            if(missing)
                set(${record} "${role} link missing symbols (exit ${rc}); see ${dir}/${role}.link.log" PARENT_SCOPE)
                set(outcome incompatible PARENT_SCOPE)
            else()
                set(${record} "${role} link inconclusive (status ${rc}); see ${dir}/${role}.link.log" PARENT_SCOPE)
            endif()
            return()
        endif()
        execute_process(COMMAND "${readelf}" -lW "${binary}" RESULT_VARIABLE rc OUTPUT_VARIABLE segments)
        if(NOT rc EQUAL 0 OR NOT segments MATCHES "Requesting program interpreter: ([^]]+)\\]")
            set(${record} "cannot identify ELF loader for ${role}" PARENT_SCOPE)
            return()
        endif()
        set(interpreter "${CMAKE_MATCH_1}")
        command(rc "${dir}/${role}.loader.log" "${interpreter}" --list "${binary}")
        if(NOT rc EQUAL 0)
            set(${record} "loader cannot resolve ${role}; see ${dir}/${role}.loader.log" PARENT_SCOPE)
            return()
        endif()
        string(REPLACE "\n" ";" lines "${output}")
        set(role_loads "")
        foreach(line IN LISTS lines)
            if(NOT line MATCHES "^[ \t]*([^ \t]+)[ \t]+=>[ \t]+(/.*)[ \t]+\\(0x[0-9a-fA-F]+\\)$")
                continue()
            endif()
            set(loaded_soname "${CMAKE_MATCH_1}")
            set(loaded_path "${CMAKE_MATCH_2}")
            file(REAL_PATH "${loaded_path}" loaded_path)
            list(FIND sonames "${loaded_soname}" index)
            if(index GREATER_EQUAL 0)
                list(GET soname_paths "${index}" intended)
                if(NOT loaded_path STREQUAL intended)
                    set(${record} "wrong loader resolution for ${loaded_soname}: ${loaded_path}" PARENT_SCOPE)
                    return()
                endif()
            endif()
            within(load "${prefix}" "${loaded_path}")
            if(load)
                list(APPEND role_loads "${load}")
            elseif(loaded_soname IN_LIST staged_sonames)
                set(${record} "loader resolved the staged dependency ${loaded_soname} outside the staged TLS install: ${loaded_path}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
        if(NOT role_loads)
            set(${record} "no private library resolved for ${role}" PARENT_SCOPE)
            return()
        endif()
        string(SHA256 role_load_id "${role_loads}")
        string(APPEND plan "|${role_load_id}")
        list(REMOVE_DUPLICATES role_loads)
        list(SORT role_loads)
        if(role STREQUAL "client")
            set(private_loads "${role_loads}")
        elseif(NOT private_loads STREQUAL role_loads)
            set(${record} "client and server resolve different private libraries; see ${dir}/*.loader.log (common runtime manifest required)" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    file(WRITE "${dir}/expected-libs.txt" "")
    file(WRITE "${dir}/expected-libs.sha256" "")
    foreach(load IN LISTS private_loads)
        file(SHA256 "${load}" digest)
        file(APPEND "${dir}/expected-libs.txt" "${load}\n")
        file(APPEND "${dir}/expected-libs.sha256" "${digest}  ${load}\n")
    endforeach()
    file(WRITE "${dir}/implementation-object.txt" "${obj}\n")
    # Only identical actual ordered arguments (apart from output filenames) and
    # the same per-role loader paths establish equivalent plans.
    string(SHA256 link_id "${inputs}")
    string(SHA256 path_id "${rpath_link}")
    string(SHA256 plan "${compile_id}|${link_id}|${path_id}${plan}")
    set(outcome viable PARENT_SCOPE)
    set(plan_id "${plan}" PARENT_SCOPE)
    set(${record} "viable (${plan})" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE pc_files LIST_DIRECTORIES FALSE "${prefix}/*.pc")
file(GLOB_RECURSE staged_dsos LIST_DIRECTORIES FALSE "${prefix}/*.so" "${prefix}/*.so.*")
set(staged_sonames "")
set(seen_dsos "")
foreach(dso IN LISTS staged_dsos)
    within(real "${prefix}" "${dso}")
    if(real AND NOT real IN_LIST seen_dsos)
        list(APPEND seen_dsos "${real}")
        execute_process(COMMAND "${readelf}" -dW "${real}" OUTPUT_VARIABLE dynamic ERROR_QUIET)
        if(dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
            list(APPEND staged_sonames "${CMAKE_MATCH_1}")
        endif()
    endif()
endforeach()
set(modules "")
set(pc_dirs "")
foreach(file IN LISTS pc_files)
    get_filename_component(name "${file}" NAME_WLE)
    if(NOT name MATCHES "^[a-zA-Z0-9.+_-]+$")
        message(FATAL_ERROR "Unsupported pkg-config module name: ${name}")
    endif()
    within(canonical "${prefix}" "${file}")
    if(NOT canonical OR DEFINED pc_file_${name})
        message(FATAL_ERROR "Duplicate or non-private pkg-config module: ${name}")
    endif()
    set(pc_file_${name} "${canonical}")
    get_filename_component(dir "${file}" DIRECTORY)
    list(APPEND pc_dirs "${dir}")
    list(APPEND modules "${name}")
endforeach()
list(REMOVE_DUPLICATES pc_dirs)
list(JOIN pc_dirs ":" pc_path)
set(selected "$ENV{TURTLE_USE_MODULE}")
if(NOT selected AND EXISTS "${JOB}/module.txt")
    file(STRINGS "${JOB}/module.txt" selected LIMIT_COUNT 1)
endif()
if(selected)
    if(NOT selected IN_LIST modules)
        message(FATAL_ERROR "Requested pkg-config module ${selected} not found under ${prefix}; candidates: ${modules}")
    endif()
    set(modules "${selected}")
endif()
if(NOT modules)
    message(FATAL_ERROR "No native pkg-config usage (.pc) under ${prefix}; this build path requires staged shared libraries and exported usage")
endif()

set(classes "")
set(blockers "")
file(WRITE "${SCAN}/candidates.tsv" "")
foreach(name IN LISTS modules)
    set(outcome unresolved)
    consume("${name}" result)
    file(APPEND "${SCAN}/candidates.tsv" "${name}\t${outcome}\t${result}\n")
    if(outcome STREQUAL "viable")
        if(NOT DEFINED representative_${plan_id})
            set(representative_${plan_id} "${name}")
            list(APPEND classes "${name}")
        endif()
    elseif(outcome STREQUAL "unresolved")
        list(APPEND blockers "${name}: ${result}")
    endif()
endforeach()
list(LENGTH classes viable)
if(blockers)
    message(FATAL_ERROR "Could not establish submitted linkage: ${blockers}\nSee ${SCAN}/candidates.tsv")
elseif(viable EQUAL 0)
    message(FATAL_ERROR "No compatible exported module; see ${SCAN}/candidates.tsv and the linker logs")
elseif(viable GREATER 1)
    message(FATAL_ERROR "Multiple distinct exports can link: ${classes}. Set TURTLE_USE_MODULE to one and reuse ${JOB} to retain the native build. See ${SCAN}/candidates.tsv")
endif()
list(GET classes 0 pick)
file(MAKE_DIRECTORY "${JOB}/bin")
foreach(role IN ITEMS client server)
    configure_file("${SCAN}/${pick}/${role}" "${JOB}/bin/${role}" COPYONLY)
    configure_file("${SCAN}/${pick}/${role}.map" "${JOB}/${role}.map" COPYONLY)
endforeach()
configure_file("${SCAN}/${pick}/expected-libs.txt" "${JOB}/expected-libs.txt" COPYONLY)
configure_file("${SCAN}/${pick}/expected-libs.sha256" "${JOB}/expected-libs.sha256" COPYONLY)
configure_file("${SCAN}/candidates.tsv" "${JOB}/candidates.tsv" COPYONLY)
file(STRINGS "${SCAN}/${pick}/implementation-object.txt" implementation LIMIT_COUNT 1)
get_filename_component(object_dir "${implementation}" DIRECTORY)
configure_file("${object_dir}/implementation.d" "${JOB}/implementation.d" COPYONLY)
file(WRITE "${JOB}/module.txt" "${pick}\n")
file(WRITE "${JOB}/link-evidence.txt" "module=${pick}\nobject=${implementation}\nheaders=observed_compiler_dependencies\nloader=resolved_not_executed\nevidence=${SCAN}\n")
message(STATUS "Linked submitted implementation (${pick}); evidence: ${JOB}/link-evidence.txt")
